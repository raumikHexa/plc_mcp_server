# Copy this file to .env and adjust values as needed.
# Variable names are UPPER_CASE and map to fields in app/config.py.

APP_NAME=AI Knowledge Server

# Leave blank-commented to use the defaults (app/data and app/documents)
# DATA_DIR=M:/path/to/data
# DOCUMENTS_DIR=M:/path/to/documents

API_HOST=127.0.0.1
API_PORT=8000

MCP_HOST=127.0.0.1
MCP_PORT=8001

# Extra public hostnames allowed to reach the MCP server (comma-separated),
# e.g. your devtunnel host: abc123-8001.inc1.devtunnels.ms
# Localhost is always allowed.
MCP_ALLOWED_HOSTS=

MAX_RESULTS=5
